#LAMMPS 30 Sep 2026
#one sphere striking stationary floor obliquely

clear
units si
dimension 3
atom_style sphere
boundary f f f
newton off

region domain block -0.02 0.02 -0.02 0.02 -0.02 0.02
create_box 1 domain

create_atoms 1 single 0.0 0.0 0.003

set group all diameter 0.002
set group all density 1500.0

velocity all set 0.02 0.0 -0.05

comm_modify vel yes

pair_style granular
pair_coeff * * hertz/material 1.0e6 0.7 0.25 &
    tangential mindlin NULL 1.0 0.4 &
    damping coeff_restitution &
    limit_damping &
    rolling none &
    twisting none

fix floor all wall/gran granular &
    hertz/material 1.0e6 0.7 0.25 &
    tangential mindlin NULL 1.0 0.4 &
    damping coeff_restitution &
    limit_damping &
    rolling none &
    twisting none &
    zplane 0.0 NULL

neighbor 0.0002 bin
neigh_modify delay 0 every 1 check yes

fix integrate all nve/sphere

timestep 0.000005

dump trajectory all custom 1 wall.lammpstrj &
    id type x y z vx vy vz fx fy fz &
    omegax omegay omegaz radius

dump_modify trajectory sort id
dump_modify trajectory format float %.17g

thermo 2000
thermo_style custom step time atoms ke

run 20000